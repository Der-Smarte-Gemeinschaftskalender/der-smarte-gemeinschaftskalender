VITE_DSG_API_URL=http://localhost:8000/api
VITE_DSG_DOCS_URL=https://der-smarte-gemeinschaftskalender.de
VITE_APP_URL=

VITE_MOBILIZON_URL=
VITE_MOBILIZON_API_URL=

# Standard-Zeitzone der Instanz, muss APP_TIMEZONE im Backend entsprechen
VITE_APP_TIMEZONE="Europe/Berlin"

# Standardsprache der Instanz, muss APP_LOCALE im Backend entsprechen
VITE_APP_LOCALE=de
# Aktivierte Sprachen (kommagetrennt, verfügbar: de,en), muss APP_SUPPORTED_LOCALES im Backend entsprechen
VITE_SUPPORTED_LOCALES=de,en

# Frontend and backend strict mode should be the same
VITE_DSG_STRICT_MODE=false

# Local Development Only (prefills the login form)
VITE_LOGIN_EMAIL="dsg-admin@example.com"
VITE_LOGIN_PASSWORD="Sicher1234!"
